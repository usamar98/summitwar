# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (use a publishable key in the browser; never expose the secret key)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# Dodo Payments. The configured product must have pay-what-you-want enabled.
DODO_PAYMENTS_API_KEY=test_REPLACE_ME
DODO_PAYMENTS_WEBHOOK_KEY=whsec_REPLACE_ME
DODO_PAYMENTS_PRODUCT_ID=pdt_REPLACE_ME
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_RETURN_URL=http://localhost:3000/checkout/success

# Transactional email (development logs a safe preview when unset)
RESEND_API_KEY=re_REPLACE_ME
RESEND_FROM_EMAIL=SummitWar <climbs@summitwar.lol>

# Security
CRON_SECRET=replace-with-at-least-32-random-characters
VISITOR_FINGERPRINT_SALT=replace-with-at-least-32-random-characters
ADMIN_EMAILS=founder@example.com

# Optional operational controls
LOG_LEVEL=info
MINIMUM_BID_CENTS=100
